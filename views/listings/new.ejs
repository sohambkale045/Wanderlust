<% layout('layouts/boilerplate') -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <br>
        <h3>Create a New Listing</h3><br>
        <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Title Field -->
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listing[title]" placeholder="Enter Name" class="form-control" required>
                <div class="valid-feedback">Title looks good!</div>
                <div class="invalid-feedback">Please enter valid title</div>
            </div>

            <!-- Description Field -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" placeholder="Enter description" class="form-control" required></textarea>
                <div class="invalid-feedback">Please enter valid description</div>
            </div>

            <!-- Image Field -->
            <div class="mb-3">
                <label for="image" class="form-label">Upload Listing Image</label>
                <input type="file" name="listing[image]"  class="form-control" required>
            </div>

            <!-- Price and Country Fields -->
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="Enter price" class="form-control" required>
                    <div class="invalid-feedback">Please enter valid price</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" placeholder="Enter country" class="form-control" required>
                    <div class="invalid-feedback">Please enter valid country</div>
                </div>
            </div>

            <!-- Location Field -->
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" placeholder="Enter Location" class="form-control" required>
                <div class="invalid-feedback">Please enter valid location</div>
            </div>

            <!-- Submit Button -->
            <button class="btn btn-dark add-btn mt-3">Add</button>
        </form>
    </div>
</div>